{
  "name": "asistencia-portal",
  "private": true,
  "description": "Estilos del portal docente (Tailwind CSS). El CSS compilado se guarda en wwwroot/css/app.css.",
  "scripts": {
    "css:build": "tailwindcss -i ./Styles/app.css -o ./wwwroot/css/app.css --minify",
    "css:watch": "tailwindcss -i ./Styles/app.css -o ./wwwroot/css/app.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "tailwindcss": "4.3.3"
  }
}

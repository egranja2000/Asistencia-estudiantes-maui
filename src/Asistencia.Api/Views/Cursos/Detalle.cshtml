@model DetalleCursoViewModel
@{
    var c = Model.Curso;
    ViewData["Title"] = c.Nombre;
    var conPorcentaje = Model.Porcentajes.Where(p => p.Porcentaje is not null).ToList();
    decimal? promedio = conPorcentaje.Count > 0 ? conPorcentaje.Average(p => p.Porcentaje!.Value) : null;
    var enRiesgo = conPorcentaje.Count(p => p.Porcentaje < 80m);
    var cerradas = Model.Sesiones.Count(s => s.Estado == "Cerrada");

    static string ColorPorcentaje(decimal? v) => v switch
    {
        null => "bg-slate-300",
        >= 90m => "bg-emerald-500",
        >= 80m => "bg-lime-500",
        >= 60m => "bg-amber-500",
        _ => "bg-rose-500"
    };
}

<a asp-action="Index" class="migas">@Iconos.Svg("atras", "size-4") Mis cursos</a>

<div class="mt-3 mb-8 flex flex-wrap items-end justify-between gap-4">
    <div>
        <div class="flex items-center gap-2 text-sm">
            <span class="rounded-md bg-slate-100 px-2 py-0.5 font-mono text-xs font-semibold text-slate-600">@c.Codigo</span>
            <span class="text-slate-400">@c.Periodo</span>
        </div>
        <h1 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">@c.Nombre</h1>
    </div>
    <button type="button" class="btn-primario" data-abrir-modal="modalNuevaSesion">
        @Iconos.Svg("mas", "size-4") Nueva sesión
    </button>
</div>

@* Indicadores *@
<div class="mb-8 grid grid-cols-2 gap-4 lg:grid-cols-4">
    <div class="kpi">
        <span class="kpi-icono bg-marca-50 text-marca-600">@Iconos.Svg("usuarios", "size-6")</span>
        <div><div class="kpi-valor">@c.Matriculados</div><div class="kpi-etiqueta">Estudiantes</div></div>
    </div>
    <div class="kpi">
        <span class="kpi-icono bg-sky-50 text-sky-600">@Iconos.Svg("calendario", "size-6")</span>
        <div><div class="kpi-valor">@Model.Sesiones.Count</div><div class="kpi-etiqueta">Sesiones · @cerradas cerradas</div></div>
    </div>
    <div class="kpi">
        <span class="kpi-icono bg-emerald-50 text-emerald-600">@Iconos.Svg("grafico", "size-6")</span>
        <div><div class="kpi-valor">@(promedio?.ToString("0.0") ?? "—")<span class="text-base font-semibold text-slate-400">%</span></div><div class="kpi-etiqueta">Asistencia promedio</div></div>
    </div>
    <div class="kpi">
        <span class="kpi-icono @(enRiesgo > 0 ? "bg-rose-50 text-rose-600" : "bg-slate-50 text-slate-400")">@Iconos.Svg("alerta", "size-6")</span>
        <div><div class="kpi-valor">@enRiesgo</div><div class="kpi-etiqueta">Bajo el 80 %</div></div>
    </div>
</div>

@* Grid: sesiones *@
<section class="grid-datos mb-8" data-grid data-grid-tamano="10" data-grid-archivo="sesiones-@c.Codigo">
    <div class="grid-barra">
        <div>
            <h2 class="tarjeta-titulo">Sesiones</h2>
            <p class="text-xs text-slate-500">Haz clic en una fila para ver la asistencia</p>
        </div>
        <div class="flex w-full items-center gap-2 sm:w-auto">
            <div class="relative flex-1 sm:flex-none">
                <span class="pointer-events-none absolute inset-y-0 left-3 grid place-items-center text-slate-400">@Iconos.Svg("buscar", "size-4")</span>
                <input type="search" class="grid-buscar" placeholder="Buscar sesión…" data-grid-buscar />
            </div>
            <button type="button" class="btn-secundario px-3" title="Exportar a Excel (CSV)" data-grid-exportar>@Iconos.Svg("descargar", "size-4") <span class="hidden sm:inline">Exportar</span></button>
        </div>
    </div>
    <div class="overflow-x-auto">
        <table class="grid-tabla">
            <thead>
            <tr>
                <th data-ordenable>Fecha</th>
                <th data-ordenable>Tema</th>
                <th data-ordenable>Modalidad</th>
                <th data-ordenable data-tipo="numero" class="text-center">Checkpoints</th>
                <th data-ordenable>Estado</th>
                <th data-no-exportar><span class="sr-only">Acciones</span></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var s in Model.Sesiones)
            {
                var inicio = Zona.ALocal(s.InicioUtc);
                <tr class="cursor-pointer" data-href="@Url.Action("Detalle", "Sesiones", new { id = s.SesionId })">
                    <td data-valor="@inicio.ToString("yyyy-MM-dd HH:mm")" data-exportar="@inicio.ToString("dd/MM/yyyy HH:mm")">
                        <div class="font-medium text-slate-900">@inicio.ToString("ddd dd MMM yyyy")</div>
                        <div class="text-xs text-slate-500">@inicio.ToString("HH:mm") – @Zona.ALocal(s.FinUtc).ToString("HH:mm")</div>
                    </td>
                    <td class="max-w-xs truncate">@(s.Tema ?? "—")</td>
                    <td><span class="@(s.EsOnline ? "modalidad-online" : "modalidad-presencial")">@s.Modalidad</span></td>
                    <td class="text-center font-medium">@s.Checkpoints</td>
                    <td><span class="estado-@s.Estado.ToLowerInvariant()">@s.Estado</span></td>
                    <td class="text-right">
                        <a asp-controller="Sesiones" asp-action="Detalle" asp-route-id="@s.SesionId" class="btn-enlace">Abrir @Iconos.Svg("derecha", "size-4")</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <div class="grid-vacio" data-grid-vacio hidden>@(Model.Sesiones.Count == 0 ? "Aún no hay sesiones. Crea la primera con «Nueva sesión»." : "Ninguna sesión coincide con la búsqueda.")</div>
    <div class="grid-pie" data-grid-pie></div>
</section>

@* Grid: porcentaje de asistencia *@
<section class="grid-datos" data-grid data-grid-tamano="10" data-grid-archivo="asistencia-@c.Codigo">
    <div class="grid-barra">
        <div>
            <h2 class="tarjeta-titulo">Porcentaje de asistencia</h2>
            <p class="text-xs text-slate-500">Sesiones cerradas · Presente y Justificado valen 1, Parcial 0,5</p>
        </div>
        <div class="flex w-full items-center gap-2 sm:w-auto">
            <div class="relative flex-1 sm:flex-none">
                <span class="pointer-events-none absolute inset-y-0 left-3 grid place-items-center text-slate-400">@Iconos.Svg("buscar", "size-4")</span>
                <input type="search" class="grid-buscar" placeholder="Buscar estudiante…" data-grid-buscar />
            </div>
            <button type="button" class="btn-secundario px-3" title="Exportar a Excel (CSV)" data-grid-exportar>@Iconos.Svg("descargar", "size-4") <span class="hidden sm:inline">Exportar</span></button>
        </div>
    </div>
    <div class="overflow-x-auto">
        <table class="grid-tabla">
            <thead>
            <tr>
                <th data-ordenable>Estudiante</th>
                <th data-ordenable data-tipo="numero" class="text-center">Presente</th>
                <th data-ordenable data-tipo="numero" class="text-center">Parcial</th>
                <th data-ordenable data-tipo="numero" class="text-center">Ausente</th>
                <th data-ordenable data-tipo="numero" class="text-center">Justificado</th>
                <th data-ordenable data-tipo="numero" class="w-56">Asistencia</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var p in Model.Porcentajes)
            {
                var pct = p.Porcentaje;
                <tr class="@(pct < 80m ? "bg-rose-50/40" : "")">
                    <td>
                        <div class="font-medium text-slate-900">@p.Estudiante</div>
                        <div class="text-xs text-slate-500">@p.Identificacion</div>
                    </td>
                    <td class="text-center">@p.Presentes</td>
                    <td class="text-center">@p.Parciales</td>
                    <td class="text-center">@p.Ausentes</td>
                    <td class="text-center">@p.Justificados</td>
                    <td data-valor="@(pct?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")" data-exportar="@(pct?.ToString("0.0") ?? "")">
                        <div class="flex items-center gap-3">
                            <div class="barra-progreso flex-1"><span class="@ColorPorcentaje(pct)" style="width:@((pct ?? 0).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%"></span></div>
                            <span class="w-14 text-right text-sm font-semibold @(pct < 80m ? "text-rose-600" : "text-slate-800")">@(pct?.ToString("0.0") ?? "—")@(pct is null ? "" : " %")</span>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <div class="grid-vacio" data-grid-vacio hidden>@(Model.Porcentajes.Count == 0 ? "No hay estudiantes matriculados." : "Ningún estudiante coincide con la búsqueda.")</div>
    <div class="grid-pie" data-grid-pie></div>
</section>

@* Modal: nueva sesión *@
<dialog id="modalNuevaSesion" class="modal modal-lg">
    <form asp-controller="Sesiones" asp-action="Crear" method="post" data-form-sesion>
        <div class="modal-cabecera">
            <div>
                <h3 class="modal-titulo">Nueva sesión</h3>
                <p class="text-sm text-slate-500">@c.Nombre</p>
            </div>
            <button type="button" class="modal-cerrar" data-cerrar-modal aria-label="Cerrar">@Iconos.Svg("cerrar", "size-5")</button>
        </div>
        <div class="modal-cuerpo">
            <partial name="~/Views/Sesiones/_CamposSesion.cshtml" model="Model.NuevaSesion" />
        </div>
        <div class="modal-pie">
            <button type="button" class="btn-secundario" data-cerrar-modal>Cancelar</button>
            <button class="btn-primario">@Iconos.Svg("mas", "size-4") Crear sesión</button>
        </div>
    </form>
</dialog>
